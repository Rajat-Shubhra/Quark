{
  "name": "quark",
  "private": true,
  "workspaces": [
    "web",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n web,server -c blue,green \"node web/dev.mjs\" \"npm run dev -w server\"",
    "dev:web": "node web/dev.mjs",
    "dev:server": "npm run dev -w server",
    "build": "node scripts/build.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
