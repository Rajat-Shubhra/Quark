# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# ── Supabase ─────────────────────────────────────────────────────────────
# Create a project at https://supabase.com → Project Settings → API
# SUPABASE_URL and SUPABASE_ANON_KEY are safe for the browser (RLS protects data).
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# SERVER-ONLY. Bypasses Row-Level Security. Must never reach the browser bundle.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── AI provider ──────────────────────────────────────────────────────────
# SERVER-ONLY. Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key

# Later: swap in the Anthropic API (see README).
# ANTHROPIC_API_KEY=your-anthropic-key
